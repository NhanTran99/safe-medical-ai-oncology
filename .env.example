# Safe Medical AI Oncology — development environment template.
# Copy to `.env` and adjust locally. Do not commit `.env` or real secrets.
# All variables are consumed via the SMA_ prefix (see 08_Development/implementation/src/safe_medical_ai/config.py).

SMA_APP_NAME=safe-medical-ai-oncology
SMA_ENVIRONMENT=development
SMA_LOG_LEVEL=INFO

# PostgreSQL is the locked structured-runtime-storage direction (TECH_STACK.md).
# Connection is not yet implemented by this scaffolding; placeholder only.
SMA_DATABASE_URL=

# Track 3 BATCH 02: OpenAI API provider (optional). Leave SMA_OPENAI_API_KEY
# blank for offline/no-key development — DeterministicLocalProvider is used
# instead. Never commit a real key here or in `.env`.
SMA_OPENAI_API_KEY=
SMA_OPENAI_MODEL=gpt-5.4-mini
